#!/bin/sh
# async-jq: runs an async-jq flow (see README.md and SPEC.md).
#
# Usage: async-jq [options] <flow.json>
#        async-jq [options] --flow JSON
#
# Runs the flow in the given flow document (relative paths in it being
# relative to the document's directory), or the flow given in place
# (relative paths being relative to the current directory). Prints the
# result (as JSON) on stdout, or the error on stderr (exit status 1).
#
# Options:
#   --flow JSON     the flow to run, given in place of a flow document
#   --input JSON    input of the flow (default: null)
#   --stdin         read the input of the flow (one JSON value) from stdin
#   --named NAME=JSON
#                   bind the named input NAME (can be repeated)
#   --envelope      print the outcome as {"result": ...} or {"error": ...}
#                   on stdout (the exit status is still 1 on error)
#   -L DIR, --library-path DIR
#                   add DIR to the jq search path of the filters (as jq's -L;
#                   can be repeated)
#   -h, --help      show this help
#
# Environment:
#   JQ_LIBRARY_PATH  colon-separated directories added to the jq search path
#                    of the filters, after the -L ones (set e.g. by
#                    `jqpm exec`; directories that don't exist are skipped)

usage() {
    echo "Usage: $0 [--input JSON | --stdin] [--named NAME=JSON]... [--envelope] [-L DIR]... (<flow.json> | --flow JSON)" >&2
    exit 1
}

INPUT=null
NAMED='{}'
FLOW=
HAS_FLOW=
ENVELOPE_OUTPUT=
LIBRARY_DIRS=
add_library_dir() {
    LIBRARY_DIRS="$LIBRARY_DIRS$1
"
}
while [ $# -gt 0 ]; do
    case "$1" in
        --flow) [ $# -ge 2 ] || usage; FLOW=$2; HAS_FLOW=1; shift 2 ;;
        --input) [ $# -ge 2 ] || usage; INPUT=$2; shift 2 ;;
        --stdin) INPUT=$(cat) || exit 1; shift ;;
        --named)
            [ $# -ge 2 ] || usage
            case "$2" in
                *=*) ;;
                *) echo "$0: --named expects NAME=JSON, got: $2" >&2; exit 1 ;;
            esac
            NAMED=$(printf '%s\n' "${2#*=}" | jq -sc --argjson named "$NAMED" --arg name "${2%%=*}" '
                if ($name | test("^[A-Za-z_][A-Za-z0-9_]*$") | not) or $name == "ENV" or $name == "ARGS"
                    or ($name | startswith("__"))
                then error("invalid named input name: \($name)")
                elif length != 1 then error("the value of \($name) must be exactly one JSON value")
                else $named + {($name): .[0]} end') || exit 1
            shift 2 ;;
        --envelope) ENVELOPE_OUTPUT=1; shift ;;
        -L|--library-path)
            [ $# -ge 2 ] || usage
            DIR=$(CDPATH= cd -- "$2" 2>/dev/null && pwd) || { echo "$0: no such directory: $2" >&2; exit 1; }
            add_library_dir "$DIR"; shift 2 ;;
        -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
        -*) usage ;;
        *) break ;;
    esac
done
if [ -n "$HAS_FLOW" ]; then
    [ $# -eq 0 ] || usage
else
    [ $# -eq 1 ] || usage
fi

# the library is in ../lib relative to this script (following symlinks, so
# that the script can be linked from a directory in the PATH)
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF") || exit 1
    case "$LINK" in
        /*) SELF=$LINK ;;
        *) SELF=$(dirname "$SELF")/$LINK ;;
    esac
done
__aj_lib=$(CDPATH= cd -- "$(dirname "$SELF")/../lib" && pwd) || exit 1

# JQ_LIBRARY_PATH: colon-separated, after the -L directories
REST=$JQ_LIBRARY_PATH
while [ -n "$REST" ]; do
    case "$REST" in
        *:*) ENTRY=${REST%%:*}; REST=${REST#*:} ;;
        *) ENTRY=$REST; REST= ;;
    esac
    if [ -n "$ENTRY" ] && DIR=$(CDPATH= cd -- "$ENTRY" 2>/dev/null && pwd); then
        add_library_dir "$DIR"
    fi
done

# jq search path of the filters: the library, the configured directories,
# then jq's default search path
__aj_search=$(jq -nr --arg lib "$__aj_lib" --arg dirs "$LIBRARY_DIRS" '
    [$lib] + ($dirs | split("\n") | map(select(. != ""))) + ["~/.jq", "$ORIGIN/../lib/jq", "$ORIGIN/../lib"] |
    map("-L " + @sh) | join(" ")') || exit 1

__aj_tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$__aj_tmp"' EXIT
trap 'exit 1' INT TERM HUP

. "$__aj_lib/runtime.sh"

# the input goes to jq on stdin (it may be large), and must be one JSON value
__in=$(printf '%s\n' "$INPUT" | jq -sc '
    if length != 1 then error("the input must be exactly one JSON value, got \(length)") else .[0] end') || usage
__scope=$__aj_tmp/scope.json
printf '%s\n' "$NAMED" > "$__scope"

if [ -n "$HAS_FLOW" ]; then
    __script=$(printf '%s\n' "$FLOW" | __aj_parse json) || { echo "$0: invalid --flow: $__script" >&2; exit 1; }
    __script=$(printf '%s\n' "$__script" | __aj_compile "$PWD") || exit 1
    OUTCOME=$(eval "$__script")
    STATUS=$?
else
    OUTCOME=$(__aj_exec_file "$(__aj_resolve "$PWD" "$1")")
    STATUS=$?
fi
[ -n "$OUTCOME" ] || { OUTCOME=$(__aj_engine_error "the flow ended without an outcome"); STATUS=1; }

if [ "$STATUS" -ne 0 ]; then
    if [ -n "$ENVELOPE_OUTPUT" ]; then
        printf '%s\n' "$OUTCOME" | jq -c '{error: .}'
    else
        printf '%s\n' "$OUTCOME" | jq -r '"Error: \(if type == "string" then . else tojson end)"' >&2
    fi
    exit 1
fi
if [ -n "$ENVELOPE_OUTPUT" ]; then
    printf '%s\n' "$OUTCOME" | jq -c '{result: .}'
else
    printf '%s\n' "$OUTCOME" | jq .
fi
